# Use Chroma's local ONNX MiniLM embeddings by default.
# First ingest downloads the local embedding model once.
EMBEDDING_PROVIDER=local

# Optional: enable OpenAI generation and/or embeddings.
# OPENAI_API_KEY=sk-your-key
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-5-mini

DOCS_DIR=docs
CHROMA_DIR=chroma_db
COLLECTION_NAME=kubernetes_docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
